BACKEND_URL=http://localhost
CORS_ORIGINS=http://localhost
FRONTEND_URL=http://localhost

COOKIE_DOMAIN=
# LOCAL ONLY - DO NOT USE IN PRODUCTION: insecure cookie setting for plain HTTP localhost.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

JOB_QUEUE_NAME=agent_jobs:queue
JOB_RUNNER_MODE=docker
REDIS_URL=redis://redis:6379/0
# LOCAL ONLY - DO NOT USE IN PRODUCTION: disables Redis TLS certificate verification.
REDIS_SSL_VERIFY=false

GEMINI_API_KEY=

GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_CALLBACK_URL=http://localhost/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_PRIVATE_KEY=
GITHUB_PRIVATE_KEY_HOST_FILE=./private-key.pem
GITHUB_PRIVATE_KEY_PATH=/run/secrets/github_app_private_key

VITE_GITHUB_APP_INSTALL_URL=
